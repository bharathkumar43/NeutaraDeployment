# Azure AD (Microsoft Entra ID)
# Get these from Azure Portal → App Registrations → your app → Overview
VITE_AZURE_CLIENT_ID=your_azure_application_client_id
VITE_AZURE_TENANT_ID=your_azure_directory_tenant_id

# Hotjar Site ID, digits only. Not a secret — it ships in the client-side bundle.
# Only needed for a local `npm run dev`/`npm run build`; in Docker it arrives as a build arg.
# Overridden at page load by public/runtime-config.js when that file sets a value.
VITE_HOTJAR_SITE_ID=6766434
